# Exact base model used during LoRA training.
BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
# Pin this to a reviewed vLLM version or digest; do not use :latest in production.
VLLM_IMAGE=vllm/vllm-openai:REPLACE_WITH_REVIEWED_VERSION
# Model name exposed by the gateway and vLLM.
VLLM_MODEL_NAME=polyglot-ar
# Inside-container path to the mounted adapter.
LORA_ADAPTER_PATH=/models/polyglot-lora
# Host directory containing adapter_config.json and adapter_model.safetensors.
ADAPTER_HOST_PATH=./outputs/polyglot-lora
MODEL_CACHE_PATH=./.cache/huggingface
MAX_LORA_RANK=8
GATEWAY_PORT=8080
# Generate separate long random values; never commit the real file.
VLLM_API_KEY=replace-with-a-long-random-upstream-key
GATEWAY_API_KEY=replace-with-a-long-random-client-key
# Optional for gated Hugging Face models.
HF_TOKEN=
UPSTREAM_TIMEOUT_SECONDS=120
