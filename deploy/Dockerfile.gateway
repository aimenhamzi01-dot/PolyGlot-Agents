FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY deploy/requirements-serving.txt /app/requirements-serving.txt
RUN pip install --no-cache-dir -r /app/requirements-serving.txt
COPY serving /app/serving

EXPOSE 8080
CMD ["uvicorn", "serving.gateway:app", "--host", "0.0.0.0", "--port", "8080"]
